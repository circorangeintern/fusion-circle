generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String
  password  String
  role      Role     @default(SUPER_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id           Int           @id @default(autoincrement())
  name         String
  pin          String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  Int
  address      String
  country      String
  state        String
  city         String
  description  String?
  email        String        @unique
  schoolType   SchoolType
  website      String?
  courses      Course[]
  departments  Department[]
  createdBy    User          @relation("SchoolCreator", fields: [createdById], references: [id], onDelete: Cascade)
  schoolConfig SchoolConfig?
  users        User[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  firstName          String
  lastName           String
  passwordHash       String?
  phoneNumber        String?
  role               Role                @default(STUDENT)
  schoolId           Int?
  status             AccountStatus       @default(PENDING)
  auditLogs          AuditLog[]
  PasswordResetToken PasswordResetToken?
  schoolsCreated     School[]            @relation("SchoolCreator")
  student            Student?
  notifications      Notification[]
  teacher            Teacher?
  school             School?             @relation(fields: [schoolId], references: [id])
}

model Student {
  userId        Int             @id
  regNo         String?         @unique
  year          Year?
  class         Class?
  department    String?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  StudentResult StudentResult[]
  courses       Course[]        @relation("CourseToStudent")
}

model Teacher {
  userId       Int      @id
  department   String?
  studentClass Class?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses      Course[] @relation("CourseToTeacher")
}

model Department {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Course {
  id          Int           @id @default(autoincrement())
  name        String
  year        Year?
  class       Class?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  schoolId    Int
  department  String?
  isActive    Boolean       @default(true)
  school      School        @relation(fields: [schoolId], references: [id])
  ResultEntry ResultEntry[]
  students    Student[]     @relation("CourseToStudent")
  teachers    Teacher[]     @relation("CourseToTeacher")

  @@unique([name, schoolId, year, class])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolConfig {
  id           Int      @id @default(autoincrement())
  schoolId     Int      @unique
  gradingBands Json     @default("[{\"max\": 100, \"min\": 70, \"grade\": \"A\", \"point\": 5}, {\"max\": 69, \"min\": 60, \"grade\": \"B\", \"point\": 4}, {\"max\": 59, \"min\": 50, \"grade\": \"C\", \"point\": 3}, {\"max\": 49, \"min\": 45, \"grade\": \"D\", \"point\": 2}, {\"max\": 44, \"min\": 40, \"grade\": \"E\", \"point\": 1}, {\"max\": 39, \"min\": 0, \"grade\": \"F\", \"point\": 0}]")
  cgpa         Json     @default("{\"caWeight\": 30, \"passMark\": 40, \"examWeight\": 70}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ResultEntry {
  id              Int          @id @default(autoincrement())
  studentResultId Int
  courseId        Int
  caScore         Decimal      @db.Decimal(5, 2)
  examScore       Decimal      @db.Decimal(5, 2)
  totalScore      Decimal      @db.Decimal(5, 2)
  grade           String
  status          ResultStatus
  flag            ResultFlag   @default(NOT_FLAGGED)
  flagDescription String?

  resolutionDescription String? // Teacher's response/review
  resolvedAt            DateTime? // When it was resolved

  Course        Course        @relation(fields: [courseId], references: [id])
  StudentResult StudentResult @relation(fields: [studentResultId], references: [id], onDelete: Cascade)

  @@unique([studentResultId, courseId])
  @@index([courseId])
}

model StudentResult {
  id          Int           @id @default(autoincrement())
  studentId   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ResultEntry ResultEntry[]
  Student     Student       @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  isRead Boolean   @default(false)
  readAt DateTime?

  entityType String?
  entityId   Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([userId, type])
  @@index([entityType, entityId])
}

enum NotificationType {
  RESULT_PUBLISHED
  RESULT_FLAGGED
  RESULT_FLAG_RESOLVED
  COURSE_REGISTERED
  RESULT_UNFLAGGED
  RESULT_REOPENED
  TEACHER_ASSIGNED_TO_COURSE
  TEACHER_REMOVED_FROM_COURSE
}

enum SchoolType {
  UNIVERSITY
  SECONDARY_SCHOOL
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVATED
  PENDING
  DEACTIVATED
}

enum Class {
  JSS_1
  JSS_2
  JSS_3
  SS_1
  SS_2
  SS_3
}

enum Year {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  YEAR_6
  YEAR_7
}

enum ResultFlag {
  FLAGGED
  NOT_FLAGGED
}

enum ResultStatus {
  PASS
  FAIL
}
