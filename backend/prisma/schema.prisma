generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String
  password  String
  role      Role     @default(SUPER_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SchoolType {
  UNIVERSITY
  SECONDARY_SCHOOL
}

model School {
  id          Int         @id @default(autoincrement())

  name        String
  pin         String      @unique
  email       String      @unique
  website     String?

  address     String
  city        String
  state       String
  country     String

  schoolType  SchoolType
  schoolConfig SchoolConfig? 
  description String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdById Int
  createdBy   User        @relation("SchoolCreator", fields: [createdById], references: [id], onDelete: Cascade)

  users       User[]
  courses     Course[]
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  firstName    String
  lastName     String
  passwordHash String?
  phoneNumber  String?
  role         Role          @default(STUDENT)
  status       AccountStatus @default(PENDING)
  student      Student?
  teacher      Teacher?

  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  schoolsCreated School[] @relation("SchoolCreator")

  PasswordResetToken PasswordResetToken?
  auditLogs          AuditLog[]
}

model Student {
  userId Int    @id
  regNo  String? @unique
  department   String?
  year   Year?
  class  Class?
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Teacher {
  userId       Int      @id
  department   String?
  studentClass Class?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses      Course[]
}

model Course {
  id        Int      @id @default(autoincrement())
  name      String
  year      Year?
  class     Class?
  department String?
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teachers Teacher[]
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  @@unique([name, schoolId, year, class])
}


model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
  @@map("session")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model SchoolConfig {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  gradingBands Json @default("[{\"min\":70,\"max\":100,\"grade\":\"A\",\"point\":5},{\"min\":60,\"max\":69,\"grade\":\"B\",\"point\":4},{\"min\":50,\"max\":59,\"grade\":\"C\",\"point\":3},{\"min\":45,\"max\":49,\"grade\":\"D\",\"point\":2},{\"min\":40,\"max\":44,\"grade\":\"E\",\"point\":1},{\"min\":0,\"max\":39,\"grade\":\"F\",\"point\":0}]")

  cgpa Json @default("{\"caWeight\":30,\"examWeight\":70,\"passMark\":40}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVATED
  PENDING
  DEACTIVATED
}

enum Class {
  JSS_1
  JSS_2
  JSS_3
  SS_1
  SS_2
  SS_3
}

enum Year {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  YEAR_6
  YEAR_7
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
