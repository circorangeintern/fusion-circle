{
  "name": "resulttrack-backend",
  "version": "1.0.0",
  "description": "ResultTrack Backend - Automated CA and Exam Result Computation System",
  "main": "dist/index.js",
  "engines": {
    "node": "20.19.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && npx husky backend/.husky"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "husky": "^9.0.11",
    "prisma": "^5.16.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^1.6.0"
  }
}
