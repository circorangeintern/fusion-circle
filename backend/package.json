{
  "name": "resulttrack-backend",
  "version": "1.0.0",
  "description": "ResultTrack Backend - Automated CA and Exam Result Computation System",
  "main": "dist/index.js",
  "engines": {
    "node": "20.19.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && npx husky backend/.husky"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "20.19.43",
    "@types/nodemailer": "^6.4.15",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "prisma": "^5.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}